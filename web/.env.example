# Database Internal (For Docker Compose)
DB_USER=postgres
DB_PASSWORD=choose_a_strong_password
DB_NAME=kariyer_web

# Database URL (For Prisma - use the internal one for docker, or localhost for migrations)
# Inside Docker: postgresql://${DB_USER}:${DB_PASSWORD}@db-web-prod:5432/${DB_NAME}?schema=public
DATABASE_URL="postgresql://postgres:password@db-web-prod:5432/kariyer_web?schema=public"

# Authentication
JWT_SECRET="generate-a-long-random-string"
ADMIN_TOKEN="secure-token-for-admin-page"

# SMTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Kariyer Rota <noreply@magicdigital.org>"

# Shopier OSB (Otomatik Sipariş Bildirimi)
SHOPIER_OSB_USER="your_shopier_username"
SHOPIER_OSB_PASS="your_shopier_key"
SHOPIER_PREMIUM_PRODUCT_IDS="12345,67890"

# App
NEXT_PUBLIC_BASE_URL="https://kariyer.magicdigital.org"
NODE_ENV="production"
