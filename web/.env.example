# Database (compose.prod.yml uses DB_*; inside Docker: postgresql://${DB_USER}:${DB_PASSWORD}@db-web-prod:5432/${DB_NAME}?schema=public)
DB_USER=postgres
DB_PASSWORD=choose_a_strong_password
DB_NAME=kariyer_web
DATABASE_URL=postgresql://postgres:password@localhost:5433/kariyer_web?schema=public
JWT_SECRET=change-me-min-32-chars
ADMIN_TOKEN=change-me
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AI reports (Pro). Without a key, reports fall back to the basic template summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mail (magic link, Friday reminder, Pro expiry). Without SMTP in dev, /giris shows the login link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Promotly <no-reply@magicdigital.org>"
# Local demo only: show the login link even under `next start` (NODE_ENV=production). Never set in prod.
DEMO_MODE=

# Scheduler secret for GET /api/cron/reminders?secret=...
CRON_SECRET=

# Pricing A/B test: monthly price variants (each must exist in YEARLY_PRICES in src/lib/plans.js)
NEXT_PUBLIC_PRICE_VARIANTS=199

# Shopier
SHOPIER_OSB_USER=
SHOPIER_OSB_PASS=
SHOPIER_PRO_MONTHLY_URL=
SHOPIER_PRO_YEARLY_URL=
# Optional per-variant links: SHOPIER_PRO_MONTHLY_URL_149=..., SHOPIER_PRO_YEARLY_URL_249=...
SHOPIER_PRO_MONTHLY_PRODUCT_IDS=
SHOPIER_PRO_YEARLY_PRODUCT_IDS=
# Legacy one-off report product
SHOPIER_PREMIUM_PRODUCT_IDS=
SHOPIER_PREMIUM_URL=
