# Production Environment Variables
# Copy this file to .env.prod and fill in the values

# Domain Configuration
PRODUCTION_DOMAIN=kariyer-rota-api.magicdigital.org

# Application Configuration
NODE_ENV=production
PORT=3000

# JWT Secret (CHANGE THIS - Use a strong random string, min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-database-password-change-this
POSTGRES_DB=kariyerrota
DB_HOST=postgres
DB_PORT=5432

# Optional: Database URL (alternative to individual DB_* variables)
# DATABASE_URL=postgresql://postgres:password@postgres:5432/kariyerrota

# Optional: Logging
LOG_LEVEL=info

